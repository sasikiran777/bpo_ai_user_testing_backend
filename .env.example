ENV=development
PORT=8080
LOG_LEVEL=info
LOG_SPACED=true
AI_LOG_RAW=false

DB_NAME=ai_user_test
DB_USER=postgres
DB_PORT=5432
DB_PASSWORD=change-me
DB_HOST=localhost
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

JWT_SECRET=change-me
JWT_TTL_MINUTES=1440

USER_TEST_CRON_ENABLED=true
USER_TEST_CRON_SECONDS=60

GRADER_URL=http://localhost:8000
GRADER_TOKEN=change-me
GRADER_TIMEOUT_SECONDS=180
